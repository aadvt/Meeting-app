# Copy to .env.local and fill in. Only the "Required" block is needed for the core pipeline;
# every integration below it is skipped (and reported as "skipped" in the run) when unset.

# ── Required ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=                 # LLM + 768-dim embeddings
RECALL_API_KEY=                 # meeting bot (not needed for transcript-only runs)
RECALL_REGION=us-east-1
DEEPGRAM_API_KEY=               # transcription of the bot recording

# ── LLM (optional) ────────────────────────────────────────
# LLM_PROVIDER=google           # google (default) | openai
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── Access (strongly recommended when deployed) ───────────
# MERIDIAN_ACCESS_CODE=         # shared code the UI asks for once; gates every /api route
# MERIDIAN_WEBHOOK_SECRET=      # lets scripts call the API with header x-webhook-secret instead

# ── Agent pipeline (optional) ─────────────────────────────
# AGENT_RECORDING_WAIT=         # poll (long-lived server) | defer (serverless; default on Vercel)
# AGENT_POLL_INTERVAL_MS=120000 # how often to check the bot while recording (n8n: Wait 2 Minutes)
# AGENT_MAX_POLLS=120           # give up (and alert) after this many polls (~4h at 2 min)

# ── Google: Gmail drafts, Calendar events, Calendar trigger ──
# OAuth refresh token with scopes gmail.compose + calendar.events
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# GMAIL_DRAFT_TO=               # optional recipient for summary drafts
# AGENT_CALENDAR_POLL=true      # poll calendar every minute in-process (long-lived server only)
# GOOGLE_CALENDAR_DEFAULT_DEPARTMENT=eng
# CRON_SECRET=                  # protects /api/agent/calendar-poll when using an external cron

# ── Slack (error alerts + meeting summaries) ──────────────
# SLACK_WEBHOOK_URL=

# ── Jira (action items → issues, engineering only) ────────
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_ID=10035
# JIRA_ISSUE_TYPE_ID=10043

# ── GitHub (action items → issues; AI file commits, engineering only) ──
# GITHUB_TOKEN=                 # fine-grained PAT: Issues + Contents read/write
# GITHUB_OWNER=Ayush5091
# GITHUB_REPO=Control
# GITHUB_BRANCH=                # defaults to the repo's default branch
# AGENT_ENABLE_CODE_COMMITS=false  # true = let the LLM commit files requested in meetings
# AGENT_MAX_FILE_TASKS=3
